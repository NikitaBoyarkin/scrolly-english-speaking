---
import '../components/scrolly/style.css';
import '../styles/global.css';
import type { ScrollyPageConfig, ScrollyFrontmatter } from '../scrolly/types';
import { mergePageConfig } from '../scrolly/merge';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

interface Props {
  frontmatter: ScrollyFrontmatter;
}

const { frontmatter } = Astro.props;
const configId = frontmatter?.configId || 'default';

const dataModules = import.meta.glob('../scrolly/data/*.ts', { eager: true }) as Record<
  string,
  { config?: ScrollyPageConfig }
>;

const baseConfig = Object.values(dataModules).find((m) => m?.config?.configId === configId)?.config;

if (!baseConfig) {
  throw new Error(`No scrolly data module found for configId: ${configId}`);
}

// Safe merge: only plain-text metadata and theme overrides from MDX frontmatter.
// Hero HTML, sections and footer HTML always come from the trusted data module.
const { metadata, theme } = mergePageConfig(baseConfig, frontmatter);
const hero = baseConfig.hero;
const sections = baseConfig.sections || [];
const footerHtml = baseConfig.footerHtml || '';

const accent = theme.accent || '#ff6643';
const paper = theme.paper || '#ffffff';
const paperDark = theme.paperDark || '#f7f7f7';
const ink = theme.ink || '#111111';
const secondary = theme.secondary || '#0f766e';

const runtimeConfig = sections.map((s) => ({
  id: s.id,
  vizKey: s.viz?.key,
  vizProps: s.viz?.props,
}));

const title = metadata.title || 'Scrolly Story';
const description = metadata.description || '';
const origin = Astro.url.origin;
const pageUrl = Astro.url.href;
const ogImageUrl = `${origin}${base}og-image.png`;
const faviconSvg = `${base}favicon.svg`;
const faviconIco = `${base}favicon.ico`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  url: pageUrl,
  image: ogImageUrl,
  inLanguage: 'ru',
  author: { '@type': 'Organization', name: metadata.brand || 'DSWoK' },
  publisher: { '@type': 'Organization', name: metadata.brand || 'DSWoK' },
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content={accent} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          var s = localStorage.getItem('scrolly-theme');
          var d = s === 'dark' || (!s && window.matchMedia('(prefers-color-scheme: dark)').matches);
          if (d) document.documentElement.classList.add('dark-theme');
        } catch (e) {}
      })();
    </script>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href={faviconSvg} />
    <link rel="icon" type="image/x-icon" href={faviconIco} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content={metadata.brand || 'Scrolly'} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ru_RU" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <style
      set:html={`:root { --accent: ${accent}; --paper: ${paper}; --paper-dark: ${paperDark}; --ink: ${ink}; --secondary: ${secondary}; }`}
    ></style>
    <script
      type="application/json"
      id="scrolly-section-config"
      is:inline
      set:html={JSON.stringify(runtimeConfig)}
    />
  </head>
  <body class="scrollytelling-theme">
    <div
      class="progress-bar"
      role="progressbar"
      aria-label="Прогресс чтения"
      aria-valuemin="0"
      aria-valuemax="100"
    >
    </div>
    <button class="theme-toggle" aria-label="Переключить тёмную тему" aria-pressed="false"
      >🌓</button
    >

    {
      metadata.homeNavUrl && (
        <a href={base} class="home-link">
          ← {metadata.brand || 'Home'}
        </a>
      )
    }
    <a
      href="https://nikitaboyarkin.github.io/Personal_Projects.github.io/"
      class="home-link portfolio-link"
      target="_blank"
      rel="noopener noreferrer"
    >
      Портфолио ↗
    </a>

    <header class="hero">
      <div class="hero-inner">
        {hero.label && <div class="hero-label">{hero.label}</div>}
        <h1 class="hero-title" set:html={hero.titleHtml || title} />
        {hero.subtitleHtml && <p class="hero-subtitle" set:html={hero.subtitleHtml} />}
        {hero.authorsHtml && <div class="hero-meta" set:html={hero.authorsHtml} />}
        {hero.teaserHtml && <p class="hero-teaser" set:html={hero.teaserHtml} />}
        {
          hero.ctaHref && (
            <a href={hero.ctaHref} class="hero-cta">
              Начать →
            </a>
          )
        }
        {
          hero.stats && (
            <div class="hero-stats">
              {hero.stats.map((stat) => (
                <div class="hero-stat">
                  <div class="hero-stat-value">
                    {stat.target}
                    <span class="hero-stat-unit">{stat.unit}</span>
                  </div>
                  <div class="hero-stat-label">{stat.label}</div>
                </div>
              ))}
            </div>
          )
        }
      </div>
    </header>

    <nav class="nav-dots" aria-label="Section navigation">
      {
        sections.map((s) => (
          <button
            class="nav-dot"
            data-target={s.id}
            aria-label={`Jump to ${s.navLabel || s.id}`}
            title={s.navLabel || s.id}
          />
        ))
      }
    </nav>

    <main class="body-columns">
      <article class="narrative-column">
        <slot />
      </article>

      <aside class="viz-column" aria-label="Visualizations">
        <div class="viz-sticky">
          {
            sections.map((s) => {
              const viz = s.viz;
              return (
                <div class="viz-panel" data-panel-for={s.id} style={{ display: 'flex' }}>
                  {viz && (
                    <div class="viz-header">
                      <div class="viz-header-text">
                        <div class="viz-title" id={`viz-title-${s.id}`}>
                          {viz.title}
                        </div>
                        {viz.captionHtml && <div class="viz-caption" set:html={viz.captionHtml} />}
                      </div>
                      {viz.key === 'checklist' && (
                        <button
                          class="viz-reset"
                          type="button"
                          data-reset-checklist={s.id}
                          aria-label="Сбросить отметки чек-листа"
                        >
                          Сбросить
                        </button>
                      )}
                    </div>
                  )}
                  <div class="viz-stage">
                    {viz ? (
                      viz.mount === 'svg' ? (
                        <svg
                          id={`chart-${s.id}`}
                          data-viz-mount
                          role="img"
                          aria-labelledby={`viz-title-${s.id}`}
                          width="100%"
                          height="100%"
                        />
                      ) : (
                        <div
                          id={`chart-${s.id}`}
                          data-viz-mount
                          class="viz-div-mount"
                          role="img"
                          aria-labelledby={`viz-title-${s.id}`}
                        />
                      )
                    ) : (
                      <div class="viz-caption">
                        Визуализация для этого раздела пока не настроена.
                      </div>
                    )}
                  </div>
                  {viz?.legend && (
                    <div class="viz-legend">
                      {viz.legend.map((item) => (
                        <span class="viz-legend-item">
                          <span class="viz-legend-swatch" style={{ backgroundColor: item.color }} />
                          {item.label}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              );
            })
          }
        </div>
      </aside>
    </main>

    {footerHtml && <footer class="scrolly-footer" set:html={footerHtml} />}

    <script src="../scrolly/scrolly-entry.ts"></script>
  </body>
</html>
