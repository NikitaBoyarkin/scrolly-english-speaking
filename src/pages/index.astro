---
import type { MarkdownInstance } from 'astro';
import '../styles/global.css';
import '../components/scrolly/style.css';
import '../styles/listing.css';
import Head from '../components/Head.astro';
import type { ScrollyPageConfig } from '../scrolly/types';

export const prerender = true;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

type Post = MarkdownInstance<{ configId?: string }>;

const posts = import.meta.glob('../posts/scrolly/*.mdx', { eager: true }) as Record<string, Post>;
const dataModules = import.meta.glob('../scrolly/data/*.ts', { eager: true }) as Record<
  string,
  { config?: ScrollyPageConfig }
>;

const configs = new Map<string, ScrollyPageConfig>();
for (const mod of Object.values(dataModules)) {
  if (mod?.config?.configId) configs.set(mod.config.configId, mod.config);
}

interface StoryCard {
  slug: string;
  config: ScrollyPageConfig;
}

const stories: StoryCard[] = Object.values(posts)
  .map((post) => {
    const slug = post.file.split('/').pop()?.replace('.mdx', '') || '';
    const configId = post.frontmatter?.configId || slug;
    const config = configs.get(configId);
    return config ? { slug, config } : null;
  })
  .filter((s): s is StoryCard => s !== null)
  .sort((a, b) => (a.config.metadata.title || '').localeCompare(b.config.metadata.title || ''));

const siteTitle = 'Scrolly English Speaking';
const siteDescription =
  'Scrollytelling-исследования и гайды по английскому для рабочих разговоров.';
const pageUrl = Astro.url.href;
---

<!doctype html>
<html lang="ru">
  <head>
    <Head
      title={siteTitle}
      description={siteDescription}
      pageUrl={pageUrl}
      base={base}
      siteName="Scrolly English Speaking"
      accent="#ff6643"
      themeVars={{
        accent: '#ff6643',
        paper: '#f4efca',
        'paper-dark': '#fff6de',
        ink: '#18181b',
        secondary: '#0f766e',
      }}
    />
  </head>
  <body class="scrollytelling-theme">
    <header class="listing-hero">
      <div class="listing-hero-inner">
        <div class="hero-label">Гайды</div>
        <h1 class="listing-title">{siteTitle}</h1>
        <p class="listing-subtitle">{siteDescription}</p>
      </div>
    </header>

    <main class="stories-list">
      {
        stories.map((s) => (
          <a class="story-card" href={`${base}${s.slug}`}>
            <div class="story-card-label">{s.config.hero.label || 'Гайд'}</div>
            <h2
              class="story-card-title"
              set:html={s.config.hero.titleHtml || s.config.metadata.title}
            />
            {s.config.metadata.description && (
              <p class="story-card-desc">{s.config.metadata.description}</p>
            )}
            {s.config.hero.stats && (
              <div class="story-card-stats">
                {s.config.hero.stats.map((stat) => (
                  <span class="story-card-stat">
                    <strong>{stat.target}</strong>
                    <span class="hero-stat-unit">{stat.unit}</span> {stat.label}
                  </span>
                ))}
              </div>
            )}
            <span class="story-card-cta">Читать →</span>
          </a>
        ))
      }
    </main>
  </body>
</html>
