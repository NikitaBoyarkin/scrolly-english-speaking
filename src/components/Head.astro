---
/**
 * Shared <head> for every page: charset/viewport, theme-init (FOUC-free),
 * SEO + social meta, favicon, manifest, optional JSON-LD and CSS theme tokens.
 * Single source of truth so the story layout and the listing page can't drift.
 */

interface Props {
  title: string;
  description: string;
  pageUrl: string;
  base: string;
  siteName?: string;
  /** Theme-color meta + the accent used by brand meta. */
  accent?: string;
  ogType?: 'article' | 'website';
  /** Optional structured data (e.g. Article). Rendered only when provided. */
  jsonLd?: Record<string, unknown>;
  /** CSS custom properties injected as `:root { ... }` (theme tokens). */
  themeVars?: Record<string, string>;
}

const { title, description, pageUrl, base, siteName, accent, ogType, jsonLd, themeVars } =
  Astro.props;

const ogImageUrl = `${new URL(base, pageUrl).origin}${base}og-image.png`;
const faviconSvg = `${base}favicon.svg`;
const faviconIco = `${base}favicon.ico`;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content={accent || '#ff6643'} />
<link rel="manifest" href={`${base}manifest.webmanifest`} />
<title>{title}</title>
<script is:inline>
  (function () {
    try {
      var s = localStorage.getItem('scrolly-theme');
      var d = s === 'dark' || (!s && window.matchMedia('(prefers-color-scheme: dark)').matches);
      if (d) document.documentElement.classList.add('dark-theme');
    } catch (e) {}
  })();
</script>
<meta name="description" content={description} />
<link rel="canonical" href={pageUrl} />
<link rel="icon" type="image/svg+xml" href={faviconSvg} />
<link rel="icon" type="image/x-icon" href={faviconIco} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType || 'website'} />
<meta property="og:url" content={pageUrl} />
<meta property="og:site_name" content={siteName || 'Scrolly'} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="ru_RU" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
{jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
<link rel="sitemap" href={`${base}sitemap-index.xml`} />
{
  themeVars && (
    <style
      set:html={`:root { ${Object.entries(themeVars)
        .map(([k, v]) => `--${k}: ${v};`)
        .join(' ')} }`}
    />
  )
}
